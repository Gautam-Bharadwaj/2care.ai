# --- Database ---
DATABASE_URL=postgresql+asyncpg://twocare:twocare@localhost:5432/twocare

# --- Redis (Celery broker + session cache) ---
REDIS_URL=redis://localhost:6379/0

# --- Backend HTTP ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# URL the agent uses to call backend tools
BACKEND_URL=http://localhost:8000

# --- LiveKit ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Configured outbound SIP trunk (Twilio-backed) for outbound dialing
LIVEKIT_SIP_TRUNK_ID=

# --- Voice pipeline providers ---
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
GROQ_API_KEY=
# Used for memory embeddings (text-embedding-3-small, 1536 dims)
OPENAI_API_KEY=

# --- Twilio (SIP trunk credentials live on LiveKit; these are for SMS / fallback) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
